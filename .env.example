# Database
DATABASE_URL="postgresql://consultancy:consultancy@localhost:5432/tbd?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# API
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Email (optional — app works without these; emails become no-ops)
# EMAIL_FROM defaults to the SMTP user; EMAIL_TO defaults to EMAIL_ADDRESS.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Aliases used when SMTP_HOST / SMTP_USER / SMTP_PASSWORD are empty (e.g. Gmail app password)
EMAIL_SMTP_SERVER=
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# AI chat (Gemini). Without a key the chat endpoints return 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend (repo-root .env — apps/web reads these from here)
# On flowmint.works / www.flowmint.works, a missing or localhost value
# is replaced at runtime with https://api.flowmint.works.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
